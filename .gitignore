# ---- .NET ----
bin/
obj/
*.user
*.suo
.vs/
artifacts/

# SQLite databases are generated by `dotnet ef database update`, never committed.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---- Node / Angular ----
node_modules/
web/dist/
web/.angular/
npm-debug.log*

dist/
coverage/
# ---- Playwright ----
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright-traces/
# Throwaway SQLite database created and destroyed by each e2e run.
e2e/.tmp/
*.trace
*.zip

# ---- Secrets / local env ----
.env
.env.*
!.env.example
secrets.json
*secrets*.json
appsettings.Local.json
appsettings.*.Local.json
appsettings.*.local.json

# ---- Extra build output ----
out/
tmp/
temp/

# ---- Editors / OS ----
.idea/
.DS_Store
*.swp
